# Copy this file to .env at the repo root, then paste in your keys.
#   cp .env.example .env
# .env is gitignored and must never be committed or pasted into Slack. .env.example is committed and stays empty.
# No key is needed for --dry-run.

# OpenRouter: strict-schema continuity planning and visual QA.
#   node utils/storylab-pack.mjs plan character --id hero --seed 42 --brief "..."
OPENROUTER_API_KEY=

# fal: seeded image generation and reference-based editing. Paste the whole key, colon included.
FAL_API_KEY=
